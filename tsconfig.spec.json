{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "vitest/globals"],
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "test/**/*.test.ts",
    "test/**/*.ts",
    "target/types/*.ts",
    "target/idl/**/*.json",
    "common/**/*.ts",
    "scripts/**/*.ts"
  ]
}
